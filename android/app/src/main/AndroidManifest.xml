<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pennyekart app links: auto-verified against
                 https://www.pennyekart.com/.well-known/assetlinks.json (the
                 real Play App Signing SHA-256 must be filled in there before
                 verification succeeds; see PLAY_STORE_CHECKLIST.md). Covers
                 only product, category, community and customer-verify routes —
                 wallet/profile/cart URLs must never be intercepted. Android
                 treats www.pennyekart.com and pennyekart.com as different
                 domains, so BOTH hosts are registered explicitly; the apex
                 host must also serve /assetlinks.json (see checklist). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.pennyekart.com"
                    android:pathPrefix="/product" />
                <data
                    android:scheme="https"
                    android:host="www.pennyekart.com"
                    android:pathPrefix="/category" />
                <data
                    android:scheme="https"
                    android:host="www.pennyekart.com"
                    android:pathPrefix="/community" />
                <data
                    android:scheme="https"
                    android:host="www.pennyekart.com"
                    android:pathPrefix="/customer/verify" />
                <data
                    android:scheme="https"
                    android:host="pennyekart.com"
                    android:pathPrefix="/product" />
                <data
                    android:scheme="https"
                    android:host="pennyekart.com"
                    android:pathPrefix="/category" />
                <data
                    android:scheme="https"
                    android:host="pennyekart.com"
                    android:pathPrefix="/community" />
                <data
                    android:scheme="https"
                    android:host="pennyekart.com"
                    android:pathPrefix="/customer/verify" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Penny Assistant voice input only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
